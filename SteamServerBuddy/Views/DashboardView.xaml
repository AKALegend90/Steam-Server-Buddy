<UserControl x:Class="SteamServerBuddy.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:conv="clr-namespace:SteamServerBuddy.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900">
    <UserControl.Resources>
        <conv:ThresholdColorConverter x:Key="ThresholdColorConverter"/>
    </UserControl.Resources>
    
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Welcome -->
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="Welcome Back" FontSize="32" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Here is what's happening with your servers." FontSize="16" Foreground="White"/>
            </StackPanel>

            <!-- Stats Grid -->
            <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,20">
                <materialDesign:Card Padding="20" Margin="5" Background="#2D2D30">
                    <StackPanel>
                        <materialDesign:PackIcon Kind="Server" Width="30" Height="30" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                        <TextBlock Text="{Binding TotalServers}" FontSize="36" FontWeight="Bold" Margin="0,10,0,0" Foreground="White"/>
                        <TextBlock Text="Total Servers" FontSize="14" Foreground="White"/>
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Padding="20" Margin="5" Background="#2D2D30">
                    <StackPanel>
                        <materialDesign:PackIcon Kind="PlayCircle" Width="30" Height="30" Foreground="#4CAF50"/>
                        <TextBlock Text="{Binding RunningServers}" FontSize="36" FontWeight="Bold" Margin="0,10,0,0" Foreground="White"/>
                        <TextBlock Text="Running Now" FontSize="14" Foreground="White"/>
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Padding="20" Margin="5" Background="#2D2D30">
                    <StackPanel>
                        <materialDesign:PackIcon Kind="Steam" Width="30" Height="30" Foreground="#00ADEF"/>
                        <TextBlock Text="{Binding SteamCMDStatus}" FontSize="18" FontWeight="Bold" Margin="0,25,0,0" TextWrapping="Wrap" Foreground="White"/>
                        <Button Command="{Binding FixSteamCMDCommand}" Content="FIX / SETUP" Margin="0,10,0,0" 
                                Style="{DynamicResource MaterialDesignTextButton}"
                                Visibility="{Binding IsSteamCMDInstalled, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                        <TextBlock Text="SteamCMD Status" FontSize="14" Foreground="White"/>
                    </StackPanel>
                </materialDesign:Card>
            </UniformGrid>

            <!-- System Monitoring -->
            <materialDesign:Card Grid.Row="2" Background="#2D2D30" Padding="20" Margin="5,0,5,20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <materialDesign:PackIcon Kind="ChartLine" Width="24" Height="24" Foreground="#4299E1" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="System Monitoring" FontSize="20" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="{Binding Uptime, StringFormat='  •  Uptime: {0}'}" FontSize="14" Foreground="Gray" VerticalAlignment="Center" Margin="20,0,0,0"/>
                    </StackPanel>

                    <UniformGrid Columns="4" Margin="0,0,0,10">
                        <!-- CPU -->
                        <Border Margin="5" Padding="15" Background="#252530" CornerRadius="8">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <materialDesign:PackIcon Kind="Cpu64Bit" Width="20" Height="20" Foreground="#4299E1"/>
                                    <TextBlock Text="CPU" FontWeight="SemiBold" Foreground="White" Margin="8,0,0,0"/>
                                </StackPanel>
                                <TextBlock FontSize="28" FontWeight="Bold" Foreground="{Binding CpuPercent, Converter={StaticResource ThresholdColorConverter}}">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0:F1}%">
                                            <Binding Path="CpuPercent"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <ProgressBar Value="{Binding CpuPercent}" Maximum="100" Height="6" Margin="0,10,0,0"
                                             Foreground="{Binding CpuPercent, Converter={StaticResource ThresholdColorConverter}}"
                                             Background="#3D3D50"/>
                            </StackPanel>
                        </Border>

                        <!-- RAM -->
                        <Border Margin="5" Padding="15" Background="#252530" CornerRadius="8">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <materialDesign:PackIcon Kind="Memory" Width="20" Height="20" Foreground="#48BB78"/>
                                    <TextBlock Text="RAM" FontWeight="SemiBold" Foreground="White" Margin="8,0,0,0"/>
                                </StackPanel>
                                <TextBlock FontSize="28" FontWeight="Bold" Foreground="{Binding RamPercent, Converter={StaticResource ThresholdColorConverter}}">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0:F1}%">
                                            <Binding Path="RamPercent"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <TextBlock Text="{Binding RamUsedGB, StringFormat='{}{0:F1} GB used'}" FontSize="11" Foreground="Gray" Margin="0,5,0,0"/>
                                <ProgressBar Value="{Binding RamPercent}" Maximum="100" Height="6" Margin="0,5,0,0"
                                             Foreground="{Binding RamPercent, Converter={StaticResource ThresholdColorConverter}}"
                                             Background="#3D3D50"/>
                            </StackPanel>
                        </Border>

                        <!-- Disk -->
                        <Border Margin="5" Padding="15" Background="#252530" CornerRadius="8">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <materialDesign:PackIcon Kind="Harddisk" Width="20" Height="20" Foreground="#ED8936"/>
                                    <TextBlock Text="{Binding DiskDrive, StringFormat='Disk ({0})'}" FontWeight="SemiBold" Foreground="White" Margin="8,0,0,0"/>
                                </StackPanel>
                                <TextBlock FontSize="28" FontWeight="Bold" Foreground="{Binding DiskPercent, Converter={StaticResource ThresholdColorConverter}}">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0:F1}%">
                                            <Binding Path="DiskPercent"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <TextBlock Text="{Binding DiskFreeGB, StringFormat='{}{0:F1} GB free'}" FontSize="11" Foreground="Gray" Margin="0,5,0,0"/>
                                <ProgressBar Value="{Binding DiskPercent}" Maximum="100" Height="6" Margin="0,5,0,0"
                                             Foreground="{Binding DiskPercent, Converter={StaticResource ThresholdColorConverter}}"
                                             Background="#3D3D50"/>
                            </StackPanel>
                        </Border>

                        <!-- Network -->
                        <Border Margin="5" Padding="15" Background="#252530" CornerRadius="8">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <materialDesign:PackIcon Kind="NetworkOutline" Width="20" Height="20" Foreground="#9F7AEA"/>
                                    <TextBlock Text="Network" FontWeight="SemiBold" Foreground="White" Margin="8,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ArrowDown" Width="16" Height="16" Foreground="#48BB78"/>
                                    <TextBlock FontSize="16" FontWeight="Bold" Foreground="#48BB78" Margin="2,0,10,0">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0:F1}">
                                                <Binding Path="NetInMbps"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <materialDesign:PackIcon Kind="ArrowUp" Width="16" Height="16" Foreground="#E53E3E"/>
                                    <TextBlock FontSize="16" FontWeight="Bold" Foreground="#E53E3E" Margin="2,0,0,0">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0:F1}">
                                                <Binding Path="NetOutMbps"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock Text="Mb/s  ↓ In  ↑ Out" FontSize="11" Foreground="Gray" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </materialDesign:Card>

            <!-- Running Processes -->
            <materialDesign:Card Grid.Row="3" Background="#2D2D30" Padding="20" Margin="5">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <materialDesign:PackIcon Kind="Application" Width="24" Height="24" Foreground="#48BB78" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Running Server Processes" FontSize="20" FontWeight="Bold" Foreground="White"/>
                    </StackPanel>

                    <!-- Process List -->
                    <ItemsControl ItemsSource="{Binding RunningProcesses}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#252530" CornerRadius="6" Padding="15" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Server Name & PID -->
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding ServerName}" FontWeight="Bold" FontSize="14" Foreground="White"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="PID: " FontSize="11" Foreground="Gray"/>
                                                <TextBlock Text="{Binding Pid}" FontSize="11" Foreground="#4299E1" Cursor="Hand">
                                                    <TextBlock.InputBindings>
                                                        <MouseBinding MouseAction="LeftClick" 
                                                                      Command="{Binding DataContext.KillProcessCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                      CommandParameter="{Binding Pid}"/>
                                                    </TextBlock.InputBindings>
                                                </TextBlock>
                                                <TextBlock Text=" (click to kill)" FontSize="11" Foreground="Gray"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- CPU -->
                                        <StackPanel Grid.Column="1" Margin="20,0" HorizontalAlignment="Center">
                                            <TextBlock Text="CPU" FontSize="10" Foreground="Gray" HorizontalAlignment="Center"/>
                                            <TextBlock FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"
                                                       Foreground="{Binding CpuPercent, Converter={StaticResource ThresholdColorConverter}}">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0:F1}%">
                                                        <Binding Path="CpuPercent"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- RAM -->
                                        <StackPanel Grid.Column="2" Margin="20,0" HorizontalAlignment="Center">
                                            <TextBlock Text="RAM" FontSize="10" Foreground="Gray" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding WorkingSetMB, StringFormat='{}{0:F0} MB'}" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Threads -->
                                        <StackPanel Grid.Column="3" Margin="20,0" HorizontalAlignment="Center">
                                            <TextBlock Text="Threads" FontSize="10" Foreground="Gray" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding ThreadCount}" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Handles -->
                                        <StackPanel Grid.Column="4" Margin="20,0" HorizontalAlignment="Center">
                                            <TextBlock Text="Handles" FontSize="10" Foreground="Gray" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding HandleCount}" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Running Time -->
                                        <StackPanel Grid.Column="5" Margin="20,0,0,0" HorizontalAlignment="Right">
                                            <TextBlock Text="Running" FontSize="10" Foreground="Gray" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding RunningTime}" FontSize="16" FontWeight="Bold" Foreground="#48BB78" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Empty State -->
                    <TextBlock Text="No servers currently running. Start a server to see process metrics here."
                               FontSize="14" Foreground="Gray" TextAlignment="Center" Margin="0,20"
                               Visibility="{Binding RunningProcesses.Count, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                </StackPanel>
            </materialDesign:Card>
        </Grid>
    </ScrollViewer>
</UserControl>
