<UserControl x:Class="SteamServerBuddy.Views.ServerGalleryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1100">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel HorizontalAlignment="Left">
                <TextBlock Text="My Servers" FontSize="32" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Click on a server to manage it" FontSize="14" Foreground="White" Opacity="0.7"/>
            </StackPanel>
            
            <Button Command="{Binding RefreshCommand}" 
                    Content="REFRESH" 
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Width="120"
                    Style="{DynamicResource MaterialDesignOutlinedButton}"/>
        </Grid>

        <!-- Card Size is fixed at 150px -->

        <!-- Loading Indicator -->
        <ProgressBar Grid.Row="2" 
                     IsIndeterminate="True"
                     Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                     Style="{DynamicResource MaterialDesignCircularProgressBar}"
                     Width="50" Height="50"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"/>

        <!-- Server Grid -->
        <ScrollViewer Grid.Row="2" 
                      VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsLoading, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
            <ItemsControl ItemsSource="{Binding Servers}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding OpenDetailCommand}"
                                Margin="0,0,20,20"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="10"
                                                        Width="150"
                                                        Height="150">
                                                    <ContentPresenter/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect Color="#4299E1" BlurRadius="15" ShadowDepth="0" Opacity="0.8"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Update" Command="{Binding OpenDetailCommand}">
                                        <MenuItem.Icon>
                                            <materialDesign:PackIcon Kind="Update"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Settings" Command="{Binding OpenDetailCommand}">
                                        <MenuItem.Icon>
                                            <materialDesign:PackIcon Kind="Cog"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Open File Location" Command="{Binding OpenFolderCommand}">
                                        <MenuItem.Icon>
                                            <materialDesign:PackIcon Kind="FolderOpen"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator/>
                                    <MenuItem Header="Uninstall" Command="{Binding UninstallCommand}" Foreground="Red">
                                        <MenuItem.Icon>
                                            <materialDesign:PackIcon Kind="TrashCan" Foreground="Red"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </Button.ContextMenu>
                            
                            <materialDesign:Card UniformCornerRadius="10">
                                <Grid>
                                    <!-- Game Image -->
                                    <Image Source="{Binding ImageSource}" 
                                           Stretch="{Binding ImageStretch}"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           Width="{Binding DataContext.CardSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           Height="{Binding DataContext.CardSize, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    
                                    <!-- Overlay with game name -->
                                    <Border Background="#DD000000" 
                                            VerticalAlignment="Bottom"
                                            CornerRadius="0,0,10,10">
                                        <StackPanel Margin="10">
                                            <TextBlock Text="{Binding Name}" 
                                                       FontSize="14" 
                                                       FontWeight="Bold" 
                                                       Foreground="White"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding AppId, StringFormat='AppID: {0}'}" 
                                                       FontSize="11" 
                                                       Foreground="White"
                                                       Opacity="0.8"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </materialDesign:Card>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
