<UserControl x:Class="SteamServerBuddy.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:conv="clr-namespace:SteamServerBuddy.Converters"
             xmlns:vm="clr-namespace:SteamServerBuddy.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">
    <UserControl.Resources>
        <!-- DataTemplates for SettingFieldViewModel -->
        <DataTemplate x:Key="TextSettingTemplate" DataType="{x:Type vm:SettingFieldViewModel}">
            <StackPanel Margin="0,10">
                <TextBlock Text="{Binding Label}" FontWeight="Bold" Margin="0,0,0,5" Foreground="White"/>
                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" 
                          Style="{DynamicResource MaterialDesignOutlinedTextBox}"
                          materialDesign:HintAssist.Hint="{Binding Description}"
                          Foreground="Black" Background="White"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="NumberSettingTemplate" DataType="{x:Type vm:SettingFieldViewModel}">
            <StackPanel Margin="0,10">
                <TextBlock Text="{Binding Label}" FontWeight="Bold" Margin="0,0,0,5" Foreground="White"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>
                    <Slider Minimum="{Binding Min}" Maximum="{Binding Max}" 
                            TickFrequency="{Binding Step}" IsSnapToTickEnabled="True"
                            Value="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                            VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{DynamicResource MaterialDesignOutlinedTextBox}"
                             Margin="10,0,0,0" VerticalAlignment="Center" 
                             Foreground="Black" Background="White"/>
                </Grid>
                <TextBlock Text="{Binding Description}" FontSize="11" Foreground="Gray" Margin="0,2,0,0"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ToggleSettingTemplate" DataType="{x:Type vm:SettingFieldViewModel}">
            <DockPanel Margin="0,10">
                <StackPanel>
                    <TextBlock Text="{Binding Label}" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="{Binding Description}" FontSize="11" Foreground="Gray" 
                               Visibility="{Binding Description, Converter={StaticResource StringToVisibilityConverter}}"/>
                </StackPanel>
                <ToggleButton IsChecked="{Binding Value}" HorizontalAlignment="Right"
                              Style="{StaticResource OnOffToggleButton}"/>
            </DockPanel>
        </DataTemplate>

        <DataTemplate x:Key="SelectSettingTemplate" DataType="{x:Type vm:SettingFieldViewModel}">
            <StackPanel Margin="0,10">
                <TextBlock Text="{Binding Label}" FontWeight="Bold" Margin="0,0,0,5" Foreground="White"/>
                <ComboBox ItemsSource="{Binding Options}" 
                          SelectedValue="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                          DisplayMemberPath="Label"
                          SelectedValuePath="Value"
                          Style="{DynamicResource MaterialDesignOutlinedComboBox}"
                          materialDesign:HintAssist.Hint="{Binding Description}"
                          Foreground="Black" Background="White"/>
            </StackPanel>
        </DataTemplate>

        <conv:SettingsTemplateSelector x:Key="SettingsSelector"
                                      TextTemplate="{StaticResource TextSettingTemplate}"
                                      NumberTemplate="{StaticResource NumberSettingTemplate}"
                                      SelectFieldTemplate="{StaticResource SelectSettingTemplate}"
                                      ToggleTemplate="{StaticResource ToggleSettingTemplate}"/>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Margin="0,0,0,20" Visibility="{Binding IsEmbedded, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="{Binding ServerName, FallbackValue='Server Settings'}" FontSize="28" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="{Binding AppId, StringFormat='Steam AppID: {0}'}" FontSize="14" Foreground="White"/>
            </StackPanel>
            <Button Command="{Binding OpenSettingsFolderCommand}" 
                    Content="SETTINGS FOLDER" 
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Style="{DynamicResource MaterialDesignOutlinedButton}"/>
        </DockPanel>

        <!-- Form -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Expander IsExpanded="True" BorderBrush="#4A5568" BorderThickness="1" Margin="0,0,0,15" Background="#2D3748"
                                  Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <Expander.Header>
                                <TextBlock Text="{Binding FileName}" Foreground="White" FontWeight="SemiBold"/>
                            </Expander.Header>
                            <Expander.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="Open File Location" 
                                              Command="{Binding OpenFileLocationCommand}" 
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                        <MenuItem.Icon>
                                            <materialDesign:PackIcon Kind="FolderOpen"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Open in Notepad" 
                                              Command="{Binding OpenInNotepadCommand}" 
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                        <MenuItem.Icon>
                                            <materialDesign:PackIcon Kind="FileEditOutline"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </Expander.ContextMenu>
                            <ItemsControl ItemsSource="{Binding Fields}" 
                                          ItemTemplateSelector="{StaticResource SettingsSelector}"
                                          Margin="15,10">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Footer / Actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <ProgressBar IsIndeterminate="True" Width="24" Height="24" Margin="0,0,20,0"
                         Style="{DynamicResource MaterialDesignCircularProgressBar}"
                         Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="0,0,20,0" Foreground="White"/>
            <Button Command="{Binding SaveCommand}" Content="SAVE SETTINGS" Width="150"/>
        </StackPanel>
    </Grid>
</UserControl>
