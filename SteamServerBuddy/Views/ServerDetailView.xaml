<UserControl x:Class="SteamServerBuddy.Views.ServerDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:v="clr-namespace:SteamServerBuddy.Views"
             xmlns:vm="clr-namespace:SteamServerBuddy.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1100">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Shared Header -->
        <Border Grid.Row="0" Margin="0,0,0,20">
            <Grid>
                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                         <!-- Back Button -->
                         <Button Command="{Binding GoBackCommand}" 
                                 Style="{StaticResource CircularBackButton}" 
                                 Margin="0,0,15,0" 
                                 ToolTip="Back to Gallery"/>
                         <!-- Server Name -->
                        <TextBlock Text="{Binding ServerName}" FontSize="32" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding AppId, StringFormat='AppID: {0}'}" FontSize="14" Foreground="White" Opacity="0.7" Margin="42,0,20,0"/>
                        
                        <!-- Live Stats -->
                        <materialDesign:PackIcon Kind="Cpu64Bit" VerticalAlignment="Center" Foreground="#4299E1" Margin="0,0,5,0"/>
                        <TextBlock Text="{Binding CpuUsage}" Foreground="White" VerticalAlignment="Center" Margin="0,0,15,0"/>

                        <materialDesign:PackIcon Kind="Memory" VerticalAlignment="Center" Foreground="#48BB78" Margin="0,0,5,0"/>
                        <TextBlock Text="{Binding MemoryUsage}" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
                
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Install Progress -->
                    <StackPanel Visibility="{Binding IsInstalling, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,10">
                        <ProgressBar Value="{Binding InstallProgress}" Height="10" Width="200" Margin="0,0,0,5"
                                     IsIndeterminate="{Binding InstallProgress, Converter={StaticResource DoubleToIsIndeterminateConverter}}"/>
                        <TextBlock Text="{Binding InstallStatus}" FontSize="11" Foreground="White" TextAlignment="Right"/>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal">
                        <!-- Start/Stop Button -->
                         <Button Command="{Binding StartStopServerCommand}" 
                                 Margin="0,0,10,0" 
                                 Width="100"
                                 Content="{Binding StartStopButtonContent}"
                                 Background="{Binding StartStopButtonBackground}"
                                 BorderBrush="{Binding StartStopButtonBackground}"
                                 Style="{DynamicResource MaterialDesignRaisedButton}"/>

                        <!-- Install Button (Visible when NOT installed) -->
                        <Button Command="{Binding UpdateServerCommand}" Content="INSTALL" Width="150"
                                IsEnabled="{Binding IsInstalling, Converter={StaticResource BooleanInverter}}"
                                Style="{DynamicResource MaterialDesignOutlinedButton}"
                                Visibility="{Binding IsInstalled, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>

                        <!-- Update Button (Visible when Installed) -->
                        <Button Command="{Binding UpdateServerCommand}" Content="UPDATE" Width="120" Margin="10,0,0,0"
                                IsEnabled="{Binding IsInstalling, Converter={StaticResource BooleanInverter}}"
                                Style="{DynamicResource MaterialDesignOutlinedButton}"
                                Visibility="{Binding IsInstalled, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                         <!-- Uninstall Button (Visible when Installed) -->
                        <Button Command="{Binding UninstallServerCommand}" Content="UNINSTALL" Width="120" Margin="10,0,0,0"
                                IsEnabled="{Binding IsInstalling, Converter={StaticResource BooleanInverter}}"
                                BorderBrush="#F44336" Foreground="#F44336"
                                Style="{DynamicResource MaterialDesignOutlinedButton}"
                                Visibility="{Binding IsInstalled, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Settings Side -->
            <Grid Grid.Column="0">
                <TabControl Style="{DynamicResource MaterialDesignFilledTabControl}" Background="Transparent">
                    <TabItem Header="SETTINGS">
                         <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Automation & Monitoring Card -->
                            <materialDesign:Card Grid.Row="0" Margin="0,0,0,10" Background="#2D3748" Padding="15" UniformCornerRadius="8">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <materialDesign:PackIcon Kind="Robot" Foreground="#ED8936" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock Text="Automation &amp; Monitoring" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                                    </StackPanel>

                                    <DockPanel Margin="0,0,0,10">
                                        <TextBlock Text="Auto-Restart on Crash" Foreground="White" VerticalAlignment="Center"/>
                                        <ToggleButton IsChecked="{Binding AutoRestart}" HorizontalAlignment="Right"
                                                      Style="{StaticResource OnOffToggleButton}"
                                                      Command="{Binding SaveAutomationSettingsCommand}"/>
                                    </DockPanel>

                                    <!-- Auto Update -->
                                    <DockPanel Margin="0,0,0,10">
                                        <TextBlock Text="Auto-Update Server" Foreground="White" VerticalAlignment="Center"/>
                                        <ToggleButton IsChecked="{Binding AutoUpdateEnabled}" HorizontalAlignment="Right"
                                                      Style="{StaticResource OnOffToggleButton}"
                                                      Command="{Binding SaveAutomationSettingsCommand}"/>
                                    </DockPanel>
                                    
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10" Visibility="{Binding AutoUpdateEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <ComboBox ItemsSource="{Binding UpdateDays}" SelectedItem="{Binding AutoUpdateDay}"
                                                  materialDesign:HintAssist.Hint="Day"
                                                  Style="{DynamicResource MaterialDesignOutlinedComboBox}"
                                                  Width="150" Margin="0,0,10,0" 
                                                  Foreground="Black"
                                                  Background="White">
                                             <ComboBox.InputBindings>
                                                <!-- Auto-save on selection change via property trigger if possible, or bind command -->
                                             </ComboBox.InputBindings>
                                        </ComboBox>

                                        <TextBox Text="{Binding AutoUpdateSchedule, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="Time (e.g. 04:00 AM)"
                                                 Style="{DynamicResource MaterialDesignOutlinedTextBox}"
                                                 Foreground="Black" Background="White" Width="150">
                                             <TextBox.InputBindings>
                                                <KeyBinding Key="Enter" Command="{Binding SaveAutomationSettingsCommand}"/>
                                                <KeyBinding Key="Return" Command="{Binding SaveAutomationSettingsCommand}"/>
                                             </TextBox.InputBindings>
                                        </TextBox>
                                    </StackPanel>


                                    
                                    <Button Command="{Binding SaveAutomationSettingsCommand}" 
                                            Content="SAVE AUTOMATION SETTINGS" 
                                            Style="{DynamicResource MaterialDesignOutlinedButton}"
                                            HorizontalAlignment="Right"/>
                                </StackPanel>
                            </materialDesign:Card>

                            <!-- Game Settings -->
                            <ContentControl Grid.Row="1" Content="{Binding SettingsVM}"/>
                        </Grid>
                    </TabItem>
                    
                    <TabItem Header="BACKUP">
                        <Grid>
                             <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <!-- Auto Backup Settings -->
                             <materialDesign:Card Grid.Row="0" Margin="0,0,0,10" Background="#2D3748" Padding="15" UniformCornerRadius="8">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <materialDesign:PackIcon Kind="BackupRestore" Foreground="#9AE6B4" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock Text="Auto Backup System" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    
                                    <DockPanel Margin="0,0,0,10">
                                        <TextBlock Text="Enable Auto Backup" Foreground="White" VerticalAlignment="Center"/>
                                        <ToggleButton IsChecked="{Binding AutoBackupEnabled}" HorizontalAlignment="Right"
                                                      Style="{StaticResource OnOffToggleButton}"
                                                      Command="{Binding SaveAutomationSettingsCommand}"/>
                                    </DockPanel>

                                    <TextBox Text="{Binding AutoBackupInterval, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="Backup Interval (Hours)"
                                             Style="{DynamicResource MaterialDesignOutlinedTextBox}"
                                             Foreground="Black" Background="White" Margin="0,0,0,5"
                                             Visibility="{Binding AutoBackupEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                     
                                     <Button Command="{Binding SaveAutomationSettingsCommand}" 
                                            Content="SAVE BACKUP SETTINGS" 
                                            Style="{DynamicResource MaterialDesignOutlinedButton}"
                                            HorizontalAlignment="Right"/>
                                </StackPanel>
                            </materialDesign:Card>
                            
                            <!-- Backups Card -->
                             <materialDesign:Card Grid.Row="1" Background="#2D3748" Padding="15" UniformCornerRadius="8" VerticalAlignment="Stretch">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    
                                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal">
                                             <materialDesign:PackIcon Kind="FolderOpen" Foreground="#9AE6B4" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                             <TextBlock Text="Manual Backups" Foreground="White" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Button Command="{Binding CreateBackupCommand}" Content="CREATE BACKUP" HorizontalAlignment="Right"
                                                Style="{DynamicResource MaterialDesignOutlinedButton}" Height="25" FontSize="10" Padding="10,0"/>
                                    </DockPanel>
                                    
                                    <ScrollViewer Grid.Row="1">
                                        <ItemsControl ItemsSource="{Binding Backups}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="#4A5568" BorderThickness="0,0,0,1" Padding="5" Background="Transparent"
                                                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                        <Border.ContextMenu>
                                                            <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                                                <MenuItem Header="Restore" 
                                                                          Command="{Binding RestoreBackupCommand}" 
                                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                                    <MenuItem.Icon>
                                                                        <materialDesign:PackIcon Kind="Restore"/>
                                                                    </MenuItem.Icon>
                                                                </MenuItem>
                                                                <MenuItem Header="Open File Location" 
                                                                          Command="{Binding OpenBackupFolderCommand}" 
                                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                                    <MenuItem.Icon>
                                                                        <materialDesign:PackIcon Kind="FolderOpen"/>
                                                                    </MenuItem.Icon>
                                                                </MenuItem>
                                                                <Separator/>
                                                                <MenuItem Header="Delete" 
                                                                          Command="{Binding DeleteBackupCommand}" 
                                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                                    <MenuItem.Icon>
                                                                        <materialDesign:PackIcon Kind="Delete" Foreground="Red"/>
                                                                    </MenuItem.Icon>
                                                                </MenuItem>
                                                            </ContextMenu>
                                                        </Border.ContextMenu>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            
                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="Bold"/>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding CreationTime}" FontSize="11" Foreground="Gray" Margin="0,0,10,0"/>
                                                                    <TextBlock Text="{Binding SizeDisplay}" FontSize="11" Foreground="Gray"/>
                                                                </StackPanel>
                                                            </StackPanel>
                                                            
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                                <Button Command="{Binding DataContext.RestoreBackupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                                        CommandParameter="{Binding}"
                                                                        ToolTip="Restore"
                                                                        Style="{DynamicResource MaterialDesignToolButton}" Padding="0" Margin="0,0,5,0">
                                                                     <materialDesign:PackIcon Kind="Restore" Foreground="#63B3ED"/>
                                                                </Button>
                                                                <Button Command="{Binding DataContext.OpenBackupFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                                        CommandParameter="{Binding}"
                                                                        ToolTip="Open File Location"
                                                                        Style="{DynamicResource MaterialDesignToolButton}" Padding="0" Margin="0,0,5,0">
                                                                     <materialDesign:PackIcon Kind="FolderOpen" Foreground="#9AE6B4"/>
                                                                </Button>
                                                                <Button Command="{Binding DataContext.DeleteBackupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                                        CommandParameter="{Binding}"
                                                                        ToolTip="Delete"
                                                                        Style="{DynamicResource MaterialDesignToolButton}" Padding="0">
                                                                     <materialDesign:PackIcon Kind="Delete" Foreground="#F56565"/>
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </materialDesign:Card>
                        </Grid>
                    </TabItem>
                    

                </TabControl>
        </Grid>
        </Grid>
    </Grid>
</UserControl>
